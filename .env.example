# Optional Cloud AI API Keys for Advanced Generative Processing
# The website includes an advanced client-side mathematical Canvas shader
# and Studio Compositor that functions 100% out of the box with ZERO API keys,
# preserving her authentic face, smile, and hairstyle without faking or stock photos.
#
# If you want to connect external Cloud Generative AI endpoints, copy this file
# to `.env.local` and add your keys:

# Replicate API Token (for SDXL Inpainting / InstantID / Flux):
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Google Gemini API Key:
# https://aistudio.google.com/
GEMINI_API_KEY=

# Stability AI API Key:
# https://platform.stability.ai/
STABILITY_API_KEY=
